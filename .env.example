# ---------------------------------------------------------------------------
# CX Sentinel AI - environment configuration. Copy to `.env` and edit.
# No secret is hard-coded in the repository; everything below is read from the environment.
# ---------------------------------------------------------------------------

# --- Application ---------------------------------------------------------
ENVIRONMENT=development
# Comma separated list of browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database (MySQL 8 is the primary store) --------------------------------
# For docker-compose the host is `db`; for a local MySQL use localhost.
DATABASE_URL=mysql+pymysql://cx_user:cx_password@localhost:3306/cx_sentinel
# If MySQL is unreachable in development, fall back to a local SQLite file so the demo still runs.
DB_FALLBACK_SQLITE=true
# Apply Alembic migrations automatically on start-up
AUTO_MIGRATE=true

# docker-compose only (used to create the MySQL container)
MYSQL_ROOT_PASSWORD=change-this-root-password
MYSQL_DATABASE=cx_sentinel
MYSQL_USER=cx_user
MYSQL_PASSWORD=cx_password

# --- Security --------------------------------------------------------------
# Generate a long random value:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_MINUTES=480

# --- Demo mode -------------------------------------------------------------
# Demo mode creates four demo users (admin/analyst/approver/viewer @cxsentinel.ai) with DEMO_PASSWORD,
# loads the SIMULATED sample datasets on first start and (optionally) runs the full analysis.
DEMO_MODE=true
SEED_DEMO_DATA=true
AUTO_RUN_ANALYSIS=true
DEMO_PASSWORD=CxSentinel#2026

# --- LLM (optional - the platform works fully offline with LLM_PROVIDER=none) --
# none | openrouter | openai_compatible. The LLM only writes validated explanations of computed results.
LLM_PROVIDER=none
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=anthropic/claude-3.5-haiku
LLM_PRICE_IN_PER_1K=0.0008
LLM_PRICE_OUT_PER_1K=0.004

# --- Analytics -------------------------------------------------------------
# auto: use sentence-transformers MiniLM if installed (requirements-ml.txt), otherwise TF-IDF + SVD
EMBEDDING_BACKEND=auto
BASELINE_DAYS=14
RECENT_DAYS=7
# Approval is always required above this implementation cost (INR), in addition to consequential action types
APPROVAL_COST_THRESHOLD_INR=50000
# Simulated enterprise APIs fail transiently on the first attempt for this share of calls (demonstrates retries)
TOOL_FAILURE_RATE=0.18
DATA_RETENTION_DAYS=365
